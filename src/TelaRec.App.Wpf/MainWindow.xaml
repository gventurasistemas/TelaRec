<Window x:Class="TelaRec.App.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:resources="clr-namespace:TelaRec.App.Wpf.Resources"
        Title="{x:Static resources:Strings.AppTitle}" Height="760" Width="700" MinHeight="640" MinWidth="620"
        WindowStartupLocation="CenterScreen" Background="#10131A" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="BorderBrush" Value="#9AA4B2" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="CaretBrush" Value="#111827" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="BorderBrush" Value="#9AA4B2" />
            <Setter Property="Padding" Value="7" />
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Padding" Value="7,5" />
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAB4C3" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="●  TelaRec" FontSize="28" FontWeight="SemiBold" Foreground="#F7F8FA" />
            <TextBlock Text="{x:Static resources:Strings.ScreenRecorder}" Margin="0,4,0,0" FontSize="14" Foreground="#AAB4C3" />
        </StackPanel>
        <Border Grid.Row="1" Margin="0,18,0,14" Padding="18" Background="#1B2230" CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding FormatSummary}" Foreground="#8E9AAF" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding RecordingDuration}" FontFamily="Consolas" FontSize="26" Foreground="#FF5B5B" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding AudioStatusText}" Foreground="#AAB4C3" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>
        <TabControl Grid.Row="2" Background="#10131A" Foreground="#DDE3ED" BorderThickness="0">
            <TabItem Header="{x:Static resources:Strings.Recording}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.ColumnSpan="2" Text="{x:Static resources:Strings.StartHint}"
                                   Foreground="#F4C46A" TextWrapping="Wrap" Margin="0,0,0,14" />

                        <TextBlock Grid.Row="1" Text="{x:Static resources:Strings.OutputFolder}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#DDE3ED" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="2" Text="{x:Static resources:Strings.Preset}" VerticalAlignment="Center" Margin="0,14,0,0" FontWeight="SemiBold" Foreground="#DDE3ED" />
                        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,14,0,0" ItemsSource="{Binding PresetOptions}" SelectedItem="{Binding SelectedPreset}" />

                        <TextBlock Grid.Row="3" Text="FPS" VerticalAlignment="Center" Margin="0,14,0,0" FontWeight="SemiBold" Foreground="#DDE3ED" />
                        <ComboBox Grid.Row="3" Grid.Column="1" SelectedValue="{Binding FramesPerSecond}" SelectedValuePath="Content" Margin="0,14,0,0">
                            <ComboBoxItem Content="30" />
                            <ComboBoxItem Content="60" />
                        </ComboBox>

                        <TextBlock Grid.Row="4" Text="{x:Static resources:Strings.Audio}" VerticalAlignment="Center" Margin="0,14,0,0" FontWeight="SemiBold" Foreground="#DDE3ED" />
                        <CheckBox Grid.Row="4" Grid.Column="1" Content="Gravar áudio do sistema" IsChecked="{Binding SystemAudioEnabled}" Margin="0,14,0,0" VerticalAlignment="Center" Foreground="#DDE3ED" />

                        <TextBlock Grid.Row="5" Text="{x:Static resources:Strings.Capture}" VerticalAlignment="Center" Margin="0,14,0,0" FontWeight="SemiBold" Foreground="#DDE3ED" />
                        <ComboBox Grid.Row="5" Grid.Column="1" SelectedValue="{Binding CaptureMode}" SelectedValuePath="Content" Margin="0,14,0,0">
                            <ComboBoxItem Content="Tela inteira" />
                            <ComboBoxItem Content="Janela selecionada" />
                            <ComboBoxItem Content="Região personalizada" />
                        </ComboBox>

                        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Selecionar janela" Click="SelectWindow" Padding="10,6" Margin="0,0,8,0" Background="#E5E7EB" Foreground="#111827" />
                            <Button Content="Selecionar região" Click="SelectRegion" Padding="10,6" Background="#E5E7EB" Foreground="#111827" />
                        </StackPanel>

                        <TextBlock Grid.Row="7" Text="{x:Static resources:Strings.Cursor}" VerticalAlignment="Center" Margin="0,16,0,0" FontWeight="SemiBold" Foreground="#DDE3ED" />
                        <CheckBox Grid.Row="7" Grid.Column="1" Content="{x:Static resources:Strings.ShowCursor}" IsChecked="{Binding ShowCursor}" Margin="0,16,0,0" VerticalAlignment="Center" Foreground="#DDE3ED" />

                        <TextBlock Grid.Row="8" Text="{x:Static resources:Strings.ClickEffects}" VerticalAlignment="Center" Margin="0,16,0,0" FontWeight="SemiBold" Foreground="#DDE3ED" />
                        <CheckBox Grid.Row="8" Grid.Column="1" Content="{x:Static resources:Strings.EnableClickEffects}" IsChecked="{Binding ShowClickEffects}" Margin="0,16,0,0" VerticalAlignment="Center" Foreground="#DDE3ED" />
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{x:Static resources:Strings.Settings}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Formato" Foreground="#DDE3ED" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" SelectedValue="{Binding OutputFormat}" SelectedValuePath="Content">
                            <ComboBoxItem Content="MP4" /><ComboBoxItem Content="MKV" /><ComboBoxItem Content="MOV" /><ComboBoxItem Content="GIF" />
                        </ComboBox>

                        <TextBlock Grid.Row="1" Text="Resolução" Foreground="#DDE3ED" Margin="0,14,0,0" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,14,0,0" SelectedValue="{Binding OutputResolution}" SelectedValuePath="Content">
                            <ComboBoxItem Content="1920×1080" /><ComboBoxItem Content="1280×720" /><ComboBoxItem Content="854×480" />
                        </ComboBox>

                        <TextBlock Grid.Row="2" Text="Bitrate (bps)" Foreground="#DDE3ED" Margin="0,14,0,0" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,14,0,0" Text="{Binding VideoBitrate}" />

                        <TextBlock Grid.Row="3" Text="{x:Static resources:Strings.Quality}" Foreground="#DDE3ED" Margin="0,14,0,0" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,14,0,0" SelectedValue="{Binding Quality}" SelectedValuePath="Content">
                            <ComboBoxItem Content="Alta" /><ComboBoxItem Content="Média" /><ComboBoxItem Content="Baixa" />
                        </ComboBox>

                        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Style="{StaticResource HintText}" Margin="0,8,0,0"
                                   Text="{x:Static resources:Strings.QualityHint}" />

                        <TextBlock Grid.Row="5" Text="{x:Static resources:Strings.ToggleRecordingHotkey}" Foreground="#DDE3ED" Margin="0,14,0,0" VerticalAlignment="Center" />
                        <TextBox Grid.Row="5" Grid.Column="1" Margin="0,14,0,0" Text="{Binding ToggleRecordingHotkey, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Ex.: Ctrl+Alt+R" />

                        <TextBlock Grid.Row="6" Text="{x:Static resources:Strings.TogglePauseHotkey}" Foreground="#DDE3ED" Margin="0,14,0,0" VerticalAlignment="Center" />
                        <TextBox Grid.Row="6" Grid.Column="1" Margin="0,14,0,0" Text="{Binding TogglePauseHotkey, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Ex.: Ctrl+Alt+P" />

                        <TextBlock Grid.Row="7" Text="{x:Static resources:Strings.ScreenshotHotkey}" Foreground="#DDE3ED" Margin="0,14,0,0" VerticalAlignment="Center" />
                        <TextBox Grid.Row="7" Grid.Column="1" Margin="0,14,0,0" Text="{Binding ScreenshotHotkey, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Ex.: Ctrl+Alt+S" />

                        <TextBlock Grid.Row="8" Text="{x:Static resources:Strings.Watermark}" Foreground="#DDE3ED" Margin="0,14,0,0" VerticalAlignment="Center" />
                        <TextBox Grid.Row="8" Grid.Column="1" Margin="0,14,0,0" Text="{Binding WatermarkText, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="9" Text="{x:Static resources:Strings.WatermarkImage}" Foreground="#DDE3ED" Margin="0,14,0,0" VerticalAlignment="Center" />
                        <TextBox Grid.Row="9" Grid.Column="1" Margin="0,14,0,0" Text="{Binding WatermarkImagePath, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="10" Text="{x:Static resources:Strings.Webcam}" Foreground="#DDE3ED" Margin="0,14,0,0" VerticalAlignment="Center" />
                        <CheckBox Grid.Row="10" Grid.Column="1" Margin="0,14,0,0" Content="{x:Static resources:Strings.Enabled}" IsChecked="{Binding WebcamEnabled}" Foreground="#DDE3ED" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="11" Text="{x:Static resources:Strings.Scale}" Foreground="#DDE3ED" Margin="0,14,0,0" VerticalAlignment="Center" />
                        <TextBox Grid.Row="11" Grid.Column="1" Margin="0,14,0,0" Text="{Binding WebcamScale}" />

                        <TextBlock Grid.Row="12" Text="{x:Static resources:Strings.Opacity}" Foreground="#DDE3ED" Margin="0,14,0,0" VerticalAlignment="Center" />
                        <TextBox Grid.Row="12" Grid.Column="1" Margin="0,14,0,0" Text="{Binding WebcamOpacity}" />

                        <TextBlock Grid.Row="13" Text="{x:Static resources:Strings.Position}" Foreground="#DDE3ED" Margin="0,14,0,0" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="13" Grid.Column="1" Margin="0,14,0,0" SelectedValue="{Binding WebcamPosition}" SelectedValuePath="Content">
                            <ComboBoxItem Content="BottomRight" /><ComboBoxItem Content="BottomLeft" /><ComboBoxItem Content="TopRight" /><ComboBoxItem Content="TopLeft" />
                        </ComboBox>

                        <TextBlock Grid.Row="14" Text="{x:Static resources:Strings.Opacity}" Foreground="#DDE3ED" Margin="0,14,0,0" VerticalAlignment="Center" />
                        <TextBox Grid.Row="14" Grid.Column="1" Margin="0,14,0,0" Text="{Binding WatermarkOpacity}" />

                        <TextBlock Grid.Row="15" Text="{x:Static resources:Strings.Scale}" Foreground="#DDE3ED" Margin="0,14,0,0" VerticalAlignment="Center" />
                        <Grid Grid.Row="15" Grid.Column="1" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding WatermarkScale}" />
                            <ComboBox Grid.Column="1" Margin="8,0,0,0" SelectedValue="{Binding WatermarkPosition}" SelectedValuePath="Content">
                                <ComboBoxItem Content="BottomRight" /><ComboBoxItem Content="BottomLeft" /><ComboBoxItem Content="TopRight" /><ComboBoxItem Content="TopLeft" />
                            </ComboBox>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="{Binding DiagnosticsText}" Foreground="#F4C46A" TextWrapping="Wrap" Margin="0,0,0,8" />
            <WrapPanel Orientation="Horizontal">
                <Button Content="{x:Static resources:Strings.Start}" Command="{Binding StartRecordingCommand}" Padding="22,10" Margin="0,0,8,8"
                        Background="#D92D20" Foreground="White" FontWeight="Bold" MinWidth="110" ToolTip="Inicia a gravação da tela" />
                <Button Content="{x:Static resources:Strings.Pause}" Command="{Binding PauseRecordingCommand}" Padding="14,9" Margin="0,0,8,8" Background="#E5E7EB" Foreground="#111827" />
                <Button Content="{x:Static resources:Strings.Resume}" Command="{Binding ResumeRecordingCommand}" Padding="14,9" Margin="0,0,8,8" Background="#E5E7EB" Foreground="#111827" />
                <Button Content="{x:Static resources:Strings.Stop}" Command="{Binding StopRecordingCommand}" Padding="14,9" Margin="0,0,8,8" Background="#E5E7EB" Foreground="#111827" />
                <Button Content="{x:Static resources:Strings.Screenshot}" Command="{Binding ScreenshotCommand}" Padding="14,9" Margin="0,0,8,8"
                        Background="#2563EB" Foreground="White" FontWeight="SemiBold" ToolTip="{x:Static resources:Strings.ScreenshotHint}" />
                <Button Content="{x:Static resources:Strings.OpenFolder}" Command="{Binding OpenOutputDirectoryCommand}" Padding="14,9" Margin="0,0,8,8" Background="#E5E7EB" Foreground="#111827" />
                <Button Content="{x:Static resources:Strings.SaveSettings}" Command="{Binding SaveSettingsCommand}" Padding="14,9" Margin="0,0,8,8" Background="#E5E7EB" Foreground="#111827" />
            </WrapPanel>
            <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="{x:Static resources:Strings.ScheduleStart}" VerticalAlignment="Center" Foreground="#AAB4C3" Margin="0,0,6,8" />
                <TextBox Width="150" Margin="0,0,12,8" Text="{Binding ScheduledStart, StringFormat={}{0:dd/MM/yyyy HH:mm}}" />
                <TextBlock Text="{x:Static resources:Strings.ScheduleMinutes}" VerticalAlignment="Center" Foreground="#AAB4C3" Margin="0,0,6,8" />
                <TextBox Width="55" Margin="0,0,10,8" Text="{Binding ScheduledMinutes}" />
                <Button Content="{x:Static resources:Strings.Schedule}" Command="{Binding ScheduleRecordingCommand}" Padding="14,9" Margin="0,0,0,8" Background="#E5E7EB" Foreground="#111827" />
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>
