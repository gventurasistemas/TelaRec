<Window x:Class="TelaRec.App.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:resources="clr-namespace:TelaRec.App.Wpf.Resources"
        Title="{x:Static resources:Strings.AppTitle}" Height="650" Width="620" MinHeight="620" MinWidth="580"
        WindowStartupLocation="CenterScreen" Background="#10131A" UseLayoutRounding="True">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="●  TelaRec" FontSize="28" FontWeight="SemiBold" Foreground="#F7F8FA" />
            <TextBlock Text="{x:Static resources:Strings.ScreenRecorder}" Margin="0,4,0,0" FontSize="14" Foreground="#AAB4C3" />
        </StackPanel>
        <Border Grid.Row="1" Margin="0,22,0,18" Padding="18" Background="#1B2230" CornerRadius="12">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="{Binding StatusMessage}" Foreground="White" FontWeight="SemiBold" />
                <TextBlock Text="MP4 • H.264" Foreground="#8E9AAF" Margin="0,5,0,0" /></StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="{Binding RecordingDuration}" FontFamily="Consolas" FontSize="26" Foreground="#FF5B5B" HorizontalAlignment="Right"/>
                <TextBlock Text="{Binding AudioStatusText}" Foreground="#AAB4C3" Margin="0,4,0,0"/></StackPanel>
            </Grid>
        </Border>
        <TabControl Grid.Row="2" Background="#10131A" Foreground="#DDE3ED" BorderThickness="0">
        <TabItem Header="{x:Static resources:Strings.Recording}">
        <Grid Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static resources:Strings.OutputFolder}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#DDE3ED" />
            <TextBox Grid.Column="1" Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" Padding="9,7" Background="#1B2230" Foreground="White" BorderBrush="#344054" />
            <TextBlock Grid.Row="1" Text="FPS" VerticalAlignment="Center" Margin="0,16,0,0" FontWeight="SemiBold" Foreground="#DDE3ED" />
            <ComboBox Grid.Row="1" Grid.Column="1" SelectedValue="{Binding FramesPerSecond}" SelectedValuePath="Content" Margin="0,16,0,0" Padding="7" Background="#1B2230" Foreground="White">
                <ComboBoxItem Content="30" />
                <ComboBoxItem Content="60" />
            </ComboBox>
            <TextBlock Grid.Row="2" Text="{x:Static resources:Strings.Audio}" VerticalAlignment="Center" Margin="0,16,0,0" FontWeight="SemiBold" Foreground="#DDE3ED" />
            <CheckBox Grid.Row="2" Grid.Column="1" Content="Gravar áudio do sistema" IsChecked="{Binding SystemAudioEnabled}" Margin="0,16,0,0" VerticalAlignment="Center" Foreground="#DDE3ED" />
            <TextBlock Grid.Row="3" Text="{x:Static resources:Strings.Capture}" VerticalAlignment="Center" Margin="0,16,0,0" FontWeight="SemiBold" Foreground="#DDE3ED" />
            <ComboBox Grid.Row="3" Grid.Column="1" SelectedValue="{Binding CaptureMode}" SelectedValuePath="Content" Margin="0,16,0,0" Padding="7" Background="#1B2230" Foreground="White">
                <ComboBoxItem Content="Tela inteira"/><ComboBoxItem Content="Janela selecionada"/><ComboBoxItem Content="Região personalizada"/>
            </ComboBox>
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Selecionar janela" Click="SelectWindow" Padding="8,4" Margin="0,0,8,0"/>
                <Button Content="Selecionar região" Click="SelectRegion" Padding="8,4"/>
            </StackPanel>
        </Grid></TabItem>
        <TabItem Header="{x:Static resources:Strings.Settings}"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="Formato" Foreground="#DDE3ED"/><ComboBox Grid.Column="1" Width="170" HorizontalAlignment="Left" Margin="110,0,0,0" SelectedValue="{Binding OutputFormat}" SelectedValuePath="Content"><ComboBoxItem Content="MP4"/><ComboBoxItem Content="MKV"/><ComboBoxItem Content="MOV"/><ComboBoxItem Content="GIF"/></ComboBox>
            <TextBlock Grid.Row="1" Text="Resolução" Foreground="#DDE3ED" Margin="0,18,0,0"/><ComboBox Grid.Row="1" Grid.Column="1" Width="170" HorizontalAlignment="Left" Margin="110,18,0,0" SelectedValue="{Binding OutputResolution}" SelectedValuePath="Content"><ComboBoxItem Content="1920×1080"/><ComboBoxItem Content="1280×720"/><ComboBoxItem Content="854×480"/></ComboBox>
            <TextBlock Grid.Row="2" Text="Bitrate (bps)" Foreground="#DDE3ED" Margin="0,18,0,0"/><TextBox Grid.Row="2" Margin="110,18,0,0" Text="{Binding VideoBitrate}" Background="#1B2230" Foreground="White" BorderBrush="#344054"/>
            <TextBlock Grid.Row="3" Text="Qualidade" Foreground="#DDE3ED" Margin="0,18,0,0"/><ComboBox Grid.Row="3" Grid.Column="1" Width="170" HorizontalAlignment="Left" Margin="110,18,0,0"><ComboBoxItem Content="Alta"/><ComboBoxItem Content="Média"/><ComboBoxItem Content="Baixa"/></ComboBox>
            <TextBlock Grid.Row="4" Text="Atalho gravar/parar" Foreground="#DDE3ED" Margin="0,18,0,0"/><TextBox Grid.Row="4" Margin="110,18,0,0" Text="Ctrl+Alt+R" Background="#1B2230" Foreground="White" BorderBrush="#344054"/>
            <TextBlock Grid.Row="5" Text="Atalho pausar" Foreground="#DDE3ED" Margin="0,18,0,0"/><TextBox Grid.Row="5" Margin="110,18,0,0" Text="Ctrl+Alt+P" Background="#1B2230" Foreground="White" BorderBrush="#344054"/>
            <TextBlock Grid.Row="6" Text="{x:Static resources:Strings.Watermark}" Foreground="#DDE3ED" Margin="0,18,0,0"/><TextBox Grid.Row="6" Margin="110,18,0,0" Text="{Binding WatermarkText, UpdateSourceTrigger=PropertyChanged}" Background="#1B2230" Foreground="White" BorderBrush="#344054"/>
            <TextBlock Grid.Row="7" Text="{x:Static resources:Strings.WatermarkImage}" Foreground="#DDE3ED" Margin="0,18,0,0"/><TextBox Grid.Row="7" Margin="110,18,0,0" Text="{Binding WatermarkImagePath, UpdateSourceTrigger=PropertyChanged}" Background="#1B2230" Foreground="White" BorderBrush="#344054"/>
            <TextBlock Grid.Row="8" Text="{x:Static resources:Strings.Webcam}" Foreground="#DDE3ED" Margin="0,18,0,0"/><CheckBox Grid.Row="8" Margin="110,18,0,0" Content="{x:Static resources:Strings.Enabled}" IsChecked="{Binding WebcamEnabled}" Foreground="#DDE3ED"/>
            <TextBlock Grid.Row="9" Text="{x:Static resources:Strings.Scale}" Foreground="#DDE3ED" Margin="0,18,0,0"/><TextBox Grid.Row="9" Margin="110,18,0,0" Text="{Binding WebcamScale}" Background="#1B2230" Foreground="White" BorderBrush="#344054"/>
            <TextBlock Grid.Row="10" Text="{x:Static resources:Strings.Opacity}" Foreground="#DDE3ED" Margin="0,18,0,0"/><TextBox Grid.Row="10" Margin="110,18,0,0" Text="{Binding WebcamOpacity}" Background="#1B2230" Foreground="White" BorderBrush="#344054"/>
            <TextBlock Grid.Row="11" Text="{x:Static resources:Strings.Position}" Foreground="#DDE3ED" Margin="0,18,0,0"/><ComboBox Grid.Row="11" Grid.Column="1" Margin="110,18,0,0" SelectedValue="{Binding WebcamPosition}" SelectedValuePath="Content"><ComboBoxItem Content="BottomRight"/><ComboBoxItem Content="BottomLeft"/><ComboBoxItem Content="TopRight"/><ComboBoxItem Content="TopLeft"/></ComboBox>
            <TextBlock Grid.Row="12" Text="{x:Static resources:Strings.Opacity}" Foreground="#DDE3ED" Margin="0,18,0,0"/><TextBox Grid.Row="12" Margin="110,18,0,0" Text="{Binding WatermarkOpacity}" Background="#1B2230" Foreground="White" BorderBrush="#344054"/>
            <TextBlock Grid.Row="13" Text="{x:Static resources:Strings.Scale}" Foreground="#DDE3ED" Margin="0,18,0,0"/><StackPanel Grid.Row="13" Grid.Column="1" Orientation="Horizontal" Margin="110,18,0,0"><TextBox Width="70" Text="{Binding WatermarkScale}" Background="#1B2230" Foreground="White" BorderBrush="#344054"/><ComboBox Width="120" Margin="8,0,0,0" SelectedValue="{Binding WatermarkPosition}" SelectedValuePath="Content"><ComboBoxItem Content="BottomRight"/><ComboBoxItem Content="BottomLeft"/><ComboBoxItem Content="TopRight"/><ComboBoxItem Content="TopLeft"/></ComboBox></StackPanel>
        </Grid></ScrollViewer></TabItem></TabControl>
        <StackPanel Grid.Row="3" Margin="0,24,0,0">
            <TextBlock Text="{Binding DiagnosticsText}" Foreground="#F4C46A" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{x:Static resources:Strings.Start}" Command="{Binding StartRecordingCommand}" Padding="14,8" Margin="0,0,10,0" Background="#D92D20" Foreground="White" />
            <Button Content="{x:Static resources:Strings.Pause}" Command="{Binding PauseRecordingCommand}" Padding="14,8" Margin="0,0,10,0" />
            <Button Content="{x:Static resources:Strings.Resume}" Command="{Binding ResumeRecordingCommand}" Padding="14,8" Margin="0,0,10,0" />
            <Button Content="{x:Static resources:Strings.Stop}" Command="{Binding StopRecordingCommand}" Padding="14,8" Margin="0,0,10,0" />
            <Button Content="{x:Static resources:Strings.OpenFolder}" Command="{Binding OpenOutputDirectoryCommand}" Padding="14,8" Margin="0,0,10,0" />
            <Button Content="{x:Static resources:Strings.SaveSettings}" Command="{Binding SaveSettingsCommand}" Padding="14,8" />
            <TextBox Width="145" Margin="10,0,4,0" Text="{Binding ScheduledStart, StringFormat={}{0:dd/MM/yyyy HH:mm}}" />
            <TextBox Width="38" Margin="0,0,4,0" Text="{Binding ScheduledMinutes}" />
            <Button Content="Agendar" Command="{Binding ScheduleRecordingCommand}" Padding="10,8" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
