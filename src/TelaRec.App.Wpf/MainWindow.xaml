<Window x:Class="TelaRec.App.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:resources="clr-namespace:TelaRec.App.Wpf.Resources"
        xmlns:infra="clr-namespace:TelaRec.App.Wpf.Infrastructure"
        xmlns:scheduling="clr-namespace:TelaRec.Core.Scheduling;assembly=TelaRec.Core"
        xmlns:reliability="clr-namespace:TelaRec.Core.Reliability;assembly=TelaRec.Core"
        Title="{resources:Loc Key=AppTitle}" Height="820" Width="860" MinHeight="680" MinWidth="700"
        WindowStartupLocation="CenterScreen" Background="#10131A" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <infra:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="BorderBrush" Value="#9AA4B2" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="CaretBrush" Value="#111827" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="#FF5B5B" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="BorderBrush" Value="#9AA4B2" />
            <Setter Property="Padding" Value="7" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="#FF5B5B" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Padding" Value="7,5" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DDE3ED" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#E5E7EB" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#10131A" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TabPanel IsItemsHost="True" Margin="0,0,0,10" />
                            <Border Grid.Row="1" Background="{TemplateBinding Background}">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#DDE3ED" />
            <Setter Property="Background" Value="#1B2230" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8"
                                Margin="0,0,6,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D92D20" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#293244" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="#D92D20" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAB4C3" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="IconGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,7,0" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDE3ED" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4C46A" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#1B2230" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF8A8A" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ValidationBanner" TargetType="Border">
            <Setter Property="Background" Value="#3A1D1D" />
            <Setter Property="BorderBrush" Value="#FF5B5B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE714;" Style="{StaticResource IconGlyph}" FontSize="23" Foreground="#FF5B5B" Margin="0,0,10,0" />
                <TextBlock Text="TelaRec" FontSize="28" FontWeight="SemiBold" Foreground="#F7F8FA" />
            </StackPanel>
            <TextBlock Text="{resources:Loc Key=ScreenRecorder}" Margin="0,4,0,0" FontSize="14" Foreground="#AAB4C3" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,16,0,12" Padding="18" Background="#1B2230" CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding FormatSummary}" Foreground="#8E9AAF" Margin="0,5,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="16,0,0,0">
                    <TextBlock Text="{Binding RecordingDuration}" FontFamily="Consolas" FontSize="26" Foreground="#FF5B5B" HorizontalAlignment="Right" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                        <TextBlock Text="&#xE767;" Style="{StaticResource IconGlyph}" Foreground="#AAB4C3" Margin="0,0,5,0" />
                        <TextBlock Text="{Binding AudioStatusText}" Foreground="#AAB4C3" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="2">

            <!-- ===================== Gravação ===================== -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" Style="{StaticResource IconGlyph}" />
                        <TextBlock Text="{resources:Loc Key=Recording}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                    <StackPanel Margin="0,4,0,0">
                        <TextBlock Text="{resources:Loc Key=StartHint}" Foreground="#F4C46A" TextWrapping="Wrap" Margin="0,0,0,14" />

                        <Border Style="{StaticResource SectionCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="{resources:Loc Key=OutputFolder}" Style="{StaticResource FieldLabel}" />
                                <StackPanel Grid.Column="1">
                                    <TextBox x:Name="OutputDirectoryBox" Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource ErrorText}"
                                               Text="{Binding ElementName=OutputDirectoryBox, Path=(Validation.Errors)/ErrorContent}" />
                                </StackPanel>

                                <TextBlock Grid.Row="1" Text="{resources:Loc Key=Preset}" Style="{StaticResource FieldLabel}" Margin="0,14,12,0" />
                                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,14,0,0"
                                          ItemsSource="{Binding PresetOptions}" DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Value" SelectedValue="{Binding SelectedPreset}" />

                                <TextBlock Grid.Row="2" Text="{resources:Loc Key=FpsLabel}" Style="{StaticResource FieldLabel}" Margin="0,14,12,0" />
                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,14,0,0">
                                    <TextBox x:Name="FpsBox" Width="120" HorizontalAlignment="Left"
                                             Text="{Binding FramesPerSecond, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Style="{StaticResource ErrorText}"
                                               Text="{Binding ElementName=FpsBox, Path=(Validation.Errors)/ErrorContent}" />
                                </StackPanel>

                                <TextBlock Grid.Row="3" Text="{resources:Loc Key=Capture}" Style="{StaticResource FieldLabel}" Margin="0,14,12,0" />
                                <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,14,0,0"
                                          ItemsSource="{Binding CaptureModeOptions}" DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Value" SelectedValue="{Binding CaptureMode}" />

                                <TextBlock Grid.Row="4" Text="{resources:Loc Key=Display}" Style="{StaticResource FieldLabel}" Margin="0,14,12,0" />
                                <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,14,0,0"
                                          ItemsSource="{Binding DisplayOptions}" DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Index" SelectedValue="{Binding SelectedDisplayIndex}" />

                                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Click="SelectWindow" Margin="0,0,8,0" Background="#E5E7EB" Foreground="#111827">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8A7;" Style="{StaticResource IconGlyph}" />
                                            <TextBlock Text="{resources:Loc Key=SelectWindow}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="SelectRegion" Background="#E5E7EB" Foreground="#111827" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7A8;" Style="{StaticResource IconGlyph}" />
                                            <TextBlock Text="{resources:Loc Key=SelectRegion}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="ShowPreview" Background="#E5E7EB" Foreground="#111827">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE890;" Style="{StaticResource IconGlyph}" />
                                            <TextBlock Text="{resources:Loc Key=Preview}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <CheckBox Grid.ColumnSpan="2" Content="{resources:Loc Key=AudioSystem}" IsChecked="{Binding SystemAudioEnabled}" />
                                <CheckBox Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0"
                                          Content="{resources:Loc Key=ShowCursor}" IsChecked="{Binding ShowCursor}" />
                                <CheckBox Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0"
                                          Content="{resources:Loc Key=EnableClickEffects}" IsChecked="{Binding ShowClickEffects}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===================== Configurações ===================== -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" Style="{StaticResource IconGlyph}" />
                        <TextBlock Text="{resources:Loc Key=Settings}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                    <StackPanel Margin="0,4,0,0">
                        <Border Style="{StaticResource ValidationBanner}"
                                Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding ValidationSummaryText}" Foreground="#FFB4B4" TextWrapping="Wrap" />
                        </Border>

                        <!-- Vídeo -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="{resources:Loc Key=SectionVideo}" Style="{StaticResource SectionHeader}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="{resources:Loc Key=Format}" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Column="1" SelectedValue="{Binding OutputFormat}" SelectedValuePath="Content">
                                        <ComboBoxItem Content="MP4" />
                                        <ComboBoxItem Content="MKV" />
                                        <ComboBoxItem Content="MOV" />
                                        <ComboBoxItem Content="GIF" />
                                    </ComboBox>

                                    <TextBlock Grid.Row="1" Text="{resources:Loc Key=Resolution}" Style="{StaticResource FieldLabel}" Margin="0,14,12,0" />
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,14,0,0">
                                        <TextBox x:Name="ResolutionBox" Text="{Binding OutputResolution, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock Style="{StaticResource ErrorText}"
                                                   Text="{Binding ElementName=ResolutionBox, Path=(Validation.Errors)/ErrorContent}" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="2" Text="{resources:Loc Key=Bitrate}" Style="{StaticResource FieldLabel}" Margin="0,14,12,0" />
                                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,14,0,0">
                                        <TextBox x:Name="BitrateBox" Text="{Binding VideoBitrate, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock Style="{StaticResource ErrorText}"
                                                   Text="{Binding ElementName=BitrateBox, Path=(Validation.Errors)/ErrorContent}" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="3" Text="{resources:Loc Key=Quality}" Style="{StaticResource FieldLabel}" Margin="0,14,12,0" />
                                    <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,14,0,0"
                                              ItemsSource="{Binding QualityOptions}" DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Value" SelectedValue="{Binding Quality}" />

                                    <TextBlock Grid.Row="4" Text="{resources:Loc Key=FpsLabel}" Style="{StaticResource FieldLabel}" Margin="0,14,12,0" />
                                    <TextBox Grid.Row="4" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="0,14,0,0"
                                             Text="{Binding FramesPerSecond, UpdateSourceTrigger=LostFocus}" />

                                    <TextBlock Grid.Row="5" Text="{resources:Loc Key=Codec}" Style="{StaticResource FieldLabel}" Margin="0,14,12,0" />
                                    <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,14,0,0"
                                              ItemsSource="{Binding VideoCodecOptions}" DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Value" SelectedValue="{Binding SelectedVideoCodec}" />

                                    <TextBlock Grid.Row="6" Text="{resources:Loc Key=EncoderAcceleration}" Style="{StaticResource FieldLabel}" Margin="0,14,12,0" />
                                    <ComboBox Grid.Row="6" Grid.Column="1" Margin="0,14,0,0"
                                              ItemsSource="{Binding EncoderAccelerationOptions}" DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Value" SelectedValue="{Binding EncoderAcceleration}" />

                                    <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Style="{StaticResource HintText}" Margin="0,10,0,0"
                                               Text="{Binding PerformanceSummary}" />

                                    <TextBlock Grid.Row="8" Grid.ColumnSpan="2" Style="{StaticResource HintText}" Margin="0,10,0,0"
                                               Text="{resources:Loc Key=QualityHint}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Áudio -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="{resources:Loc Key=SectionAudio}" Style="{StaticResource SectionHeader}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{resources:Loc Key=AudioSource}" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AudioSourceOptions}" DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Value" SelectedValue="{Binding AudioSourceMode}" />
                                    <TextBlock Grid.Row="1" Text="{resources:Loc Key=MicrophoneDevice}" Style="{StaticResource FieldLabel}" Margin="0,12,12,0" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" ItemsSource="{Binding MicrophoneDevices}"
                                              DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedMicrophoneDeviceId}" />
                                    <TextBlock Grid.Row="2" Text="{resources:Loc Key=Gain}" Style="{StaticResource FieldLabel}" Margin="0,12,12,0" />
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                                        <TextBlock Text="{resources:Loc Key=AudioSystem}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBox Width="60" Text="{Binding SystemAudioGain, UpdateSourceTrigger=LostFocus}" />
                                        <CheckBox Content="{resources:Loc Key=Mute}" IsChecked="{Binding SystemAudioMuted}" Margin="10,0,18,0" />
                                        <TextBlock Text="{resources:Loc Key=AudioMicrophone}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBox Width="60" Text="{Binding MicrophoneGain, UpdateSourceTrigger=LostFocus}" />
                                        <CheckBox Content="{resources:Loc Key=Mute}" IsChecked="{Binding MicrophoneMuted}" Margin="10,0,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Sobreposições -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="{resources:Loc Key=SectionOverlays}" Style="{StaticResource SectionHeader}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="{resources:Loc Key=WatermarkText}" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Column="1" Text="{Binding WatermarkText, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Grid.Row="1" Text="{resources:Loc Key=WatermarkImage}" Style="{StaticResource FieldLabel}" Margin="0,14,12,0" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,14,0,0" Text="{Binding WatermarkImagePath, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Grid.Row="2" Text="{resources:Loc Key=Position}" Style="{StaticResource FieldLabel}" Margin="0,14,12,0" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,14,0,0"
                                              ItemsSource="{Binding PositionOptions}" DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Value" SelectedValue="{Binding WatermarkPosition}" />

                                    <TextBlock Grid.Row="3" Text="{resources:Loc Key=Opacity}" Style="{StaticResource FieldLabel}" Margin="0,14,12,0" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="0,14,0,0" Text="{Binding WatermarkOpacity}" />

                                    <TextBlock Grid.Row="4" Text="{resources:Loc Key=Scale}" Style="{StaticResource FieldLabel}" Margin="0,14,12,0" />
                                    <TextBox Grid.Row="4" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="0,14,0,0" Text="{Binding WatermarkScale}" />

                                    <CheckBox Grid.Row="5" Grid.ColumnSpan="2" Margin="0,16,0,0" Content="{resources:Loc Key=Webcam}" IsChecked="{Binding WebcamEnabled}" />

                                    <TextBlock Grid.Row="6" Text="{resources:Loc Key=Position}" Style="{StaticResource FieldLabel}" Margin="0,14,12,0" />
                                    <ComboBox Grid.Row="6" Grid.Column="1" Margin="0,14,0,0"
                                              ItemsSource="{Binding PositionOptions}" DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Value" SelectedValue="{Binding WebcamPosition}" />

                                    <TextBlock Grid.Row="7" Text="{resources:Loc Key=Scale}" Style="{StaticResource FieldLabel}" Margin="0,14,12,0" />
                                    <TextBox Grid.Row="7" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="0,14,0,0" Text="{Binding WebcamScale}" />

                                    <TextBlock Grid.Row="8" Text="{resources:Loc Key=Opacity}" Style="{StaticResource FieldLabel}" Margin="0,14,12,0" />
                                    <TextBox Grid.Row="8" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="0,14,0,0" Text="{Binding WebcamOpacity}" />

                                    <TextBlock Grid.Row="9" Text="{resources:Loc Key=DeviceIndex}" Style="{StaticResource FieldLabel}" Margin="0,14,12,0" />
                                    <TextBox Grid.Row="9" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="0,14,0,0" Text="{Binding WebcamDeviceIndex}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Atalhos -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="{resources:Loc Key=SectionHotkeys}" Style="{StaticResource SectionHeader}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="{resources:Loc Key=ToggleRecordingHotkey}" Style="{StaticResource FieldLabel}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBox x:Name="RecordHotkeyBox" Text="{Binding ToggleRecordingHotkey, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Style="{StaticResource ErrorText}"
                                                   Text="{Binding ElementName=RecordHotkeyBox, Path=(Validation.Errors)/ErrorContent}" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Text="{resources:Loc Key=TogglePauseHotkey}" Style="{StaticResource FieldLabel}" Margin="0,14,12,0" />
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,14,0,0">
                                        <TextBox x:Name="PauseHotkeyBox" Text="{Binding TogglePauseHotkey, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Style="{StaticResource ErrorText}"
                                                   Text="{Binding ElementName=PauseHotkeyBox, Path=(Validation.Errors)/ErrorContent}" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="2" Text="{resources:Loc Key=ScreenshotHotkey}" Style="{StaticResource FieldLabel}" Margin="0,14,12,0" />
                                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,14,0,0">
                                        <TextBox x:Name="ScreenshotHotkeyBox" Text="{Binding ScreenshotHotkey, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Style="{StaticResource ErrorText}"
                                                   Text="{Binding ElementName=ScreenshotHotkeyBox, Path=(Validation.Errors)/ErrorContent}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Saída -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="{resources:Loc Key=SectionOutput}" Style="{StaticResource SectionHeader}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="{resources:Loc Key=OutputFolder}" Style="{StaticResource FieldLabel}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBox x:Name="OutputDirectorySettingsBox" Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Style="{StaticResource ErrorText}"
                                                   Text="{Binding ElementName=OutputDirectorySettingsBox, Path=(Validation.Errors)/ErrorContent}" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Text="{resources:Loc Key=SectionWindow}" Style="{StaticResource FieldLabel}" Margin="0,14,12,0" />
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,14,0,0">
                                        <CheckBox Content="{resources:Loc Key=CloseToTray}" IsChecked="{Binding CloseToTray}" />
                                        <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0" Text="{resources:Loc Key=CloseToTrayHint}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Command="{Binding OpenOutputDirectoryCommand}" Background="#E5E7EB" Foreground="#111827" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8B7;" Style="{StaticResource IconGlyph}" />
                                                <TextBlock Text="{resources:Loc Key=OpenFolder}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding SaveSettingsCommand}" Background="#2563EB" Foreground="White" FontWeight="SemiBold">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE74E;" Style="{StaticResource IconGlyph}" />
                                                <TextBlock Text="{resources:Loc Key=SaveSettings}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===================== Agendamentos ===================== -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE787;" Style="{StaticResource IconGlyph}" />
                        <TextBlock Text="{resources:Loc Key=Schedules}" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="{resources:Loc Key=ScheduleFormHint}" Style="{StaticResource HintText}" Margin="0,0,0,12" />
                            <WrapPanel Orientation="Horizontal">
                                <StackPanel Margin="0,0,16,8">
                                    <TextBlock Text="{resources:Loc Key=ScheduleStart}" Foreground="#AAB4C3" Margin="0,0,0,4" />
                                    <TextBox Width="170" Text="{Binding ScheduledStart, StringFormat={}{0:dd/MM/yyyy HH:mm}}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,16,8">
                                    <TextBlock Text="{resources:Loc Key=ScheduleMinutes}" Foreground="#AAB4C3" Margin="0,0,0,4" />
                                    <TextBox Width="90" Text="{Binding ScheduledMinutes}" />
                                </StackPanel>
                                <Button Command="{Binding ScheduleRecordingCommand}" VerticalAlignment="Bottom" Margin="0,0,0,8" Background="#2563EB" Foreground="White" FontWeight="SemiBold">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE787;" Style="{StaticResource IconGlyph}" />
                                        <TextBlock Text="{resources:Loc Key=Schedule}" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" Margin="4,4,4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{resources:Loc Key=ColumnStart}" Foreground="#8E9AAF" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{resources:Loc Key=ColumnEnd}" Foreground="#8E9AAF" FontSize="12" />
                        <TextBlock Grid.Column="2" Text="{resources:Loc Key=ColumnState}" Foreground="#8E9AAF" FontSize="12" />
                        <TextBlock Grid.Column="3" Text="{resources:Loc Key=ScheduleMessage}" Foreground="#8E9AAF" FontSize="12" />
                        <TextBlock Grid.Column="4" Text="{resources:Loc Key=ColumnActions}" Foreground="#8E9AAF" FontSize="12" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                            <ItemsControl ItemsSource="{Binding Schedules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1B2230" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="100" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding StartsAtText}" Foreground="#DDE3ED" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding StopsAtText}" Foreground="#DDE3ED" />
                                                <TextBlock Grid.Column="2" Text="{Binding StateLabel}" FontWeight="SemiBold" Foreground="#DDE3ED">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#DDE3ED" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding State}" Value="{x:Static scheduling:ScheduledRecordingState.Pending}">
                                                                    <Setter Property="Foreground" Value="#F4C46A" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="{x:Static scheduling:ScheduledRecordingState.Recording}">
                                                                    <Setter Property="Foreground" Value="#FF5B5B" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="{x:Static scheduling:ScheduledRecordingState.Completed}">
                                                                    <Setter Property="Foreground" Value="#4ADE80" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="{x:Static scheduling:ScheduledRecordingState.Rejected}">
                                                                    <Setter Property="Foreground" Value="#FF8A8A" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="{x:Static scheduling:ScheduledRecordingState.Failed}">
                                                                    <Setter Property="Foreground" Value="#FF8A8A" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="3" Text="{Binding Message}" Foreground="#AAB4C3" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                <Button Grid.Column="4" Content="{resources:Loc Key=Cancel}" Command="{Binding CancelCommand}"
                                                        Padding="10,6" Background="#E5E7EB" Foreground="#111827"
                                                        Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="{resources:Loc Key=SchedulesEmpty}" Foreground="#8E9AAF" TextWrapping="Wrap"
                                   VerticalAlignment="Top" Margin="8,8,0,0"
                                   Visibility="{Binding HasSchedules, Converter={StaticResource InverseBoolToVisibility}}" />
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ===================== Diagnósticos ===================== -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9D2;" Style="{StaticResource IconGlyph}" />
                        <TextBlock Text="{resources:Loc Key=Diagnostics}" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{resources:Loc Key=DiagnosticsHint}" Style="{StaticResource HintText}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Command="{Binding ClearDiagnosticsCommand}" Background="#E5E7EB" Foreground="#111827" Margin="12,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" Style="{StaticResource IconGlyph}" />
                                <TextBlock Text="{resources:Loc Key=Clear}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                            <ItemsControl ItemsSource="{Binding Diagnostics}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1B2230" CornerRadius="8" Padding="12" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding TimestampText}" FontFamily="Consolas" Foreground="#8E9AAF" />
                                                <TextBlock Grid.Column="1" Text="{Binding SeverityLabel}" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#8E9AAF" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Severity}" Value="{x:Static reliability:DiagnosticSeverity.Information}">
                                                                    <Setter Property="Foreground" Value="#93C5FD" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="{x:Static reliability:DiagnosticSeverity.Warning}">
                                                                    <Setter Property="Foreground" Value="#F4C46A" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="{x:Static reliability:DiagnosticSeverity.Error}">
                                                                    <Setter Property="Foreground" Value="#FF5B5B" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="2" Text="{Binding Code}" FontFamily="Consolas" Foreground="#AAB4C3" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="3" Text="{Binding Message}" Foreground="#DDE3ED" TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="{resources:Loc Key=DiagnosticsEmpty}" Foreground="#8E9AAF" TextWrapping="Wrap"
                                   VerticalAlignment="Top" Margin="8,8,0,0"
                                   Visibility="{Binding HasDiagnostics, Converter={StaticResource InverseBoolToVisibility}}" />
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="{Binding DiagnosticsText}" Foreground="#F4C46A" TextWrapping="Wrap" Margin="0,0,0,8" />
            <WrapPanel Orientation="Horizontal">
                <Button Command="{Binding StartRecordingCommand}" Padding="24,11" Margin="0,0,8,8" MinWidth="120"
                        Background="#D92D20" Foreground="White" FontWeight="Bold" ToolTip="{resources:Loc Key=StartTooltip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" Style="{StaticResource IconGlyph}" />
                        <TextBlock Text="{resources:Loc Key=Start}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding PauseRecordingCommand}" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE769;" Style="{StaticResource IconGlyph}" />
                        <TextBlock Text="{resources:Loc Key=Pause}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ResumeRecordingCommand}" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" Style="{StaticResource IconGlyph}" />
                        <TextBlock Text="{resources:Loc Key=Resume}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding StopRecordingCommand}" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71A;" Style="{StaticResource IconGlyph}" />
                        <TextBlock Text="{resources:Loc Key=Stop}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ScreenshotCommand}" Margin="0,0,8,8" Background="#2563EB" Foreground="White" FontWeight="SemiBold" ToolTip="{resources:Loc Key=ScreenshotHint}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7C4;" Style="{StaticResource IconGlyph}" />
                        <TextBlock Text="{resources:Loc Key=Screenshot}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenOutputDirectoryCommand}" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource IconGlyph}" />
                        <TextBlock Text="{resources:Loc Key=OpenFolder}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding SaveSettingsCommand}" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" Style="{StaticResource IconGlyph}" />
                        <TextBlock Text="{resources:Loc Key=SaveSettings}" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>
