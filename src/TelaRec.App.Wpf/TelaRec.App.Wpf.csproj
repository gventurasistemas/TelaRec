<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TelaRec.Core\TelaRec.Core.csproj" />
    <ProjectReference Include="..\TelaRec.Infrastructure\TelaRec.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\TelaRec.ico" />
  </ItemGroup>

  <!-- A build local do FFmpeg não entra no Git; ela acompanha cada publicação em tools. -->
  <ItemGroup Condition="Exists('..\..\ffmpeg\bin\ffmpeg.exe')">
    <Content Include="..\..\ffmpeg\bin\ffmpeg.exe" Link="tools\ffmpeg.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\ffmpeg\LICENSE" Link="tools\FFMPEG-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\ffmpeg\README.txt" Link="tools\FFMPEG-BUILD-README.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\TelaRec.ico</ApplicationIcon>
  </PropertyGroup>

  <Target Name="RequireFfmpegForPublish" BeforeTargets="CopyFilesToPublishDirectory"
          Condition="!Exists('..\..\ffmpeg\bin\ffmpeg.exe')">
    <Error Text="FFmpeg não encontrado em ..\..\ffmpeg\bin\ffmpeg.exe. Extraia a build local antes de publicar." />
  </Target>

</Project>
