<Window x:Class="TelaRec.App.Wpf.RegionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:resources="clr-namespace:TelaRec.App.Wpf.Resources"
        Title="{resources:Loc Key=SelectRegion}"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="Manual"
        AllowsTransparency="True" Background="#50000000" Topmost="True">
    <Grid>
        <Canvas x:Name="Surface" Background="Transparent" MouseLeftButtonDown="Start" MouseMove="Move" MouseLeftButtonUp="End">
            <Rectangle x:Name="Selection" Stroke="#FF3B82F6" StrokeThickness="2" Fill="#303B82F6" Visibility="Collapsed" />
            <primitives:Thumb x:Name="TopLeft" Tag="TopLeft" Width="12" Height="12" Background="White" BorderBrush="#2563EB" BorderThickness="2" Visibility="Collapsed" DragDelta="ResizeSelection" />
            <primitives:Thumb x:Name="TopRight" Tag="TopRight" Width="12" Height="12" Background="White" BorderBrush="#2563EB" BorderThickness="2" Visibility="Collapsed" DragDelta="ResizeSelection" />
            <primitives:Thumb x:Name="BottomLeft" Tag="BottomLeft" Width="12" Height="12" Background="White" BorderBrush="#2563EB" BorderThickness="2" Visibility="Collapsed" DragDelta="ResizeSelection" />
            <primitives:Thumb x:Name="BottomRight" Tag="BottomRight" Width="12" Height="12" Background="White" BorderBrush="#2563EB" BorderThickness="2" Visibility="Collapsed" DragDelta="ResizeSelection" />
        </Canvas>
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18" Background="#D9000000" Orientation="Horizontal">
            <TextBlock Text="{resources:Loc Key=RegionSelectionHint}" Foreground="White" Margin="10,7" />
            <Button Content="{resources:Loc Key=ApplyRegion}" Click="Apply" Margin="0,4,4,4" Padding="10,3" />
            <Button Content="{resources:Loc Key=Cancel}" Click="Cancel" Margin="0,4,4,4" Padding="10,3" />
        </StackPanel>
    </Grid>
</Window>
