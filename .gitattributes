# Normaliza finais de linha e evita diffs falsos entre máquinas.
* text=auto

# Código e arquivos de projeto no padrão Windows/Visual Studio
*.cs        text eol=crlf
*.xaml      text eol=crlf
*.csproj    text eol=crlf
*.sln       text eol=crlf
*.props     text eol=crlf
*.targets   text eol=crlf
*.resx      text eol=crlf
*.manifest  text eol=crlf
*.ps1       text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf
*.json      text eol=crlf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# Binários
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.exe       binary
*.dll       binary
*.pdb       binary
